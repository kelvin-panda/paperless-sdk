<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <gradient android:angle="270" android:endColor="#80D3D3D3" android:startColor="#804B4B4B" android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#80D9D9D9" android:startColor="#807C7C7C" android:type="linear" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>