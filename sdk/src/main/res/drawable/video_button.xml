<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <gradient android:angle="270" android:endColor="#804E4E4E" android:startColor="#80A0A0A0" android:type="linear" />
            <size android:width="60dp" android:height="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#80D9D9D9" android:startColor="#807C7C7C" android:type="linear" />
            <corners android:radius="2dp" />
            <size android:width="60dp" android:height="30dp" />
        </shape>
    </item>
</selector>